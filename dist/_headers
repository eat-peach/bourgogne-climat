# Applied by Cloudflare Workers static assets.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: SAMEORIGIN

# Payload folders are always requested with ?v=<assetVersion> (scripts/stamp_asset_version.py stamps every atlas:
# dist/data and each dist/<site>/data), so browsers may keep them for a year. Root data files (index.json,
# texture-manifest.json, region.json, communes, context terrain) keep Cloudflare's default revalidation, so a new
# assetVersion is seen at once.
/data/scenes/*
  Cache-Control: public, max-age=31536000, immutable

/:site/data/scenes/*
  Cache-Control: public, max-age=31536000, immutable

/data/textures/*
  Cache-Control: public, max-age=31536000, immutable

/:site/data/textures/*
  Cache-Control: public, max-age=31536000, immutable

/data/context-textures/*
  Cache-Control: public, max-age=31536000, immutable

/:site/data/context-textures/*
  Cache-Control: public, max-age=31536000, immutable

